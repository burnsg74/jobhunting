# Copy to backend env files as needed (all optional; defaults shown).
# .env.production / .env.development are gitignored.

# API port (nginx proxies /api/ here in production)
PORT=4002

# Vault root and data dir (relative to VAULT_PATH). Used when NODE_ENV=production.
VAULT_PATH=/Users/greg/Library/CloudStorage/Dropbox/Notebooks/Work
DATA_DIR=10 Projects/Job Hunting/data

# Development reads ./data/dev unless DATA_PATH is set (absolute path override).
# DATA_PATH=/absolute/path/to/data/dir

# Wellfound pull (read by the capture script the API spawns)
# Without the key, jobs are saved unscored with fit_error: no_api_key.
# ANTHROPIC_API_KEY=
WELLFOUND_PROMPT_FILE=/Users/greg/Library/CloudStorage/Dropbox/Notebooks/Work/10 Clients/Work/Alfred/Job Hunt/8-Prompts/evaluate-job-fit.md
# WELLFOUND_SAVE_NETWORK=1     write network/job JSON dumps to capture/captures/ (off by default)
# WELLFOUND_MAX_JOBS=3         limit a run (dry run)
# WELLFOUND_SCORE_JOBS=0       skip fit scoring

# One-shot export script only (.env.export, gitignored)
# DATABASE_URL=postgres://greg@localhost:5432/jobs
